# ──────────────────────────────────────────────
# My-Campus  —  Backend Environment Example
# Copy to .env and fill in your values
# NEVER commit the real .env to git
# ──────────────────────────────────────────────

# Express server port
PORT=5000

# Environment  (development | production)
NODE_ENV=development

# MongoDB connection string
# Local : mongodb://127.0.0.1:27017/mycampus
# Atlas : mongodb+srv://<user>:<pass>@cluster.mongodb.net/mycampus
MONGO_URI=mongodb://127.0.0.1:27017/mycampus

# JWT — change JWT_SECRET to a long random string in production
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# Allowed frontend origin for CORS (no trailing slash)
CLIENT_URL=http://localhost:5173

# ── Admin seed credentials ────────────────────────────────────
# Used ONLY by: node scripts/seedAdmin.js
# Change ADMIN_PASSWORD before seeding, then delete it from .env after.
# Only ONE admin account can ever exist — the User model enforces this.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@mycampus.edu
ADMIN_PASSWORD=CHANGE_BEFORE_SEEDING
ADMIN_DEPT=Administration
